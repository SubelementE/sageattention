/*
 * SAGEAttention for Ascend 310B (dav-m300) -- edge variant.
 *
 * Differences from the 910B kernel (sageattention.asc):
 *   - FP16 QK and PV (no INT8 QK): 310B has a single fused AI core and a much
 *     smaller memory budget; the per-token INT8 quant/dequant pass is not worth
 *     it at edge shapes, and FP16 keeps the numeric path simple.
 *   - No KFC / MIX AIC-AIV: Matmul is initialised with Matmul::Init and runs
 *     synchronously on the same core (IterateAll, no async client).
 *   - Ks / V live in GM (no TSCM/NZ residency); V is used directly as bmm2's B,
 *     so there is no Vp buffer and no ones column.
 *   - Single-buffered S/P/C (fully synchronous), online softmax with explicit l.
 *
 * Target shape (edge default): BH = 8, N = 512, d = 64 (BKV = 256 -> 2 KV blocks).
 */

#include <cstdint>
#include <cmath>
#include <cfloat>
#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
#include <cstring>
#include <cstdlib>
#include "acl/acl.h"

#if !defined(__CCE_AICORE__)
#include "tiling/platform/platform_ascendc.h"
#include "tiling/matmul/matmul_tiling.h"
#endif

#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "kernel_tiling/kernel_tiling.h"
#include "data_utils.h"

// ---------------------------------------------------------------------------
// Compile-time constants
// ---------------------------------------------------------------------------
constexpr uint32_t SA310_BQ   = 64;    // q rows per block
constexpr uint32_t SA310_BKV  = 256;   // kv rows per block / cube N of bmm1
constexpr uint32_t SA310_D    = 64;    // head dim
constexpr uint32_t SA310_DV   = 64;    // V width (== d)
constexpr uint32_t SA310_KCHUNK = 64;  // K-smoothing chunk (rows)

constexpr uint32_t SA310_RESERVED_WORKSPACE = 16u * 1024u * 1024u;

// UB layout (bytes)
constexpr uint32_t SA310_UB_F32  = SA310_BQ * SA310_BKV * 4u;   // 32768: S / K-fp32 / Q-fp32
constexpr uint32_t SA310_UB_H    = SA310_BQ * SA310_BKV * 2u;   // 16384: P / K-half / Q-half
constexpr uint32_t SA310_UB_BIG  = SA310_BQ * SA310_DV * 4u;    // 16384: pv tile (V tile is 16 KB too)
constexpr uint32_t SA310_UB_H2   = SA310_BQ * SA310_D * 2u;     //  8192: output tile
constexpr uint32_t SA310_UB_OACC = SA310_BQ * SA310_DV * 4u;    // 16384: O accumulator
constexpr uint32_t SA310_UB_RW   = 1024u;
constexpr uint32_t SA310_UB_RSUM = 256u;
constexpr uint32_t SA310_UB_ROW  = 256u;
constexpr uint32_t SA310_UB_M    = 256u;
constexpr uint32_t SA310_UB_MNEW = 256u;
constexpr uint32_t SA310_UB_RMAX = 256u;
constexpr uint32_t SA310_UB_RTMP = 256u;
constexpr uint32_t SA310_UB_A    = 256u;
constexpr uint32_t SA310_UB_AB   = SA310_BQ * 8u * 4u;          // 2048: Brcb alpha
constexpr uint32_t SA310_UB_MB   = SA310_BQ * 8u * 4u;          // 2048: Brcb m / Sub
constexpr uint32_t SA310_UB_L    = 256u;
constexpr uint32_t SA310_UB_LNEW = 256u;

constexpr uint32_t SA310_UB_OFF_F32  = 0;
constexpr uint32_t SA310_UB_OFF_H    = SA310_UB_OFF_F32  + SA310_UB_F32;
constexpr uint32_t SA310_UB_OFF_BIG  = SA310_UB_OFF_H    + SA310_UB_H;
constexpr uint32_t SA310_UB_OFF_H2   = SA310_UB_OFF_BIG  + SA310_UB_BIG;
constexpr uint32_t SA310_UB_OFF_OACC = SA310_UB_OFF_H2   + SA310_UB_H2;
constexpr uint32_t SA310_UB_OFF_RW   = SA310_UB_OFF_OACC + SA310_UB_OACC;
constexpr uint32_t SA310_UB_OFF_RSUM = SA310_UB_OFF_RW   + SA310_UB_RW;
constexpr uint32_t SA310_UB_OFF_ROW  = SA310_UB_OFF_RSUM + SA310_UB_RSUM;
constexpr uint32_t SA310_UB_OFF_M    = SA310_UB_OFF_ROW  + SA310_UB_ROW;
constexpr uint32_t SA310_UB_OFF_MNEW = SA310_UB_OFF_M    + SA310_UB_M;
constexpr uint32_t SA310_UB_OFF_RMAX = SA310_UB_OFF_MNEW + SA310_UB_MNEW;
constexpr uint32_t SA310_UB_OFF_RTMP = SA310_UB_OFF_RMAX + SA310_UB_RMAX;
constexpr uint32_t SA310_UB_OFF_A    = SA310_UB_OFF_RTMP + SA310_UB_RTMP;
constexpr uint32_t SA310_UB_OFF_AB   = SA310_UB_OFF_A    + SA310_UB_A;
constexpr uint32_t SA310_UB_OFF_MB   = SA310_UB_OFF_AB   + SA310_UB_AB;
constexpr uint32_t SA310_UB_OFF_L    = SA310_UB_OFF_MB   + SA310_UB_MB;
constexpr uint32_t SA310_UB_OFF_LNEW = SA310_UB_OFF_L    + SA310_UB_L;
constexpr uint32_t SA310_UB_TOTAL    = SA310_UB_OFF_LNEW + SA310_UB_LNEW;   // ~104 KB

// ---------------------------------------------------------------------------
// Tiling blob (all 32-bit so the device copy is a plain word-wise read)
// ---------------------------------------------------------------------------
struct SageAttention310TilingData {
    uint32_t N;
    uint32_t d;
    uint32_t nRowsPadded;
    uint32_t nQBlocks;
    uint32_t nKvBlocks;
    uint32_t gridDim;
    float    invSqrtDf;
    float    invDf;
    uint32_t ksOff;
    uint32_t qPadOff;
    uint32_t sOff;
    uint32_t pOff;
    uint32_t cOff;
    uint32_t coreScratchStride;
    uint32_t BH;
};

using namespace AscendC;

// ---- matmul types: all operands in GM, fp16 in / fp32 out ------------------
using SA310_A1 = MatmulType<TPosition::GM, CubeFormat::ND, half, false>;
using SA310_B1 = MatmulType<TPosition::GM, CubeFormat::ND, half, true>;   // Ks is [N, d]
using SA310_A2 = MatmulType<TPosition::GM, CubeFormat::ND, half, false>;
using SA310_B2 = MatmulType<TPosition::GM, CubeFormat::ND, half, false>;  // V is [N, d]
using SA310_C  = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
using SA310_MM1 = Matmul<SA310_A1, SA310_B1, SA310_C>;
using SA310_MM2 = Matmul<SA310_A2, SA310_B2, SA310_C>;

__aicore__ inline void ReadTilingBlob310(__gm__ uint8_t* tilingGm, SageAttention310TilingData& h,
                                         TCubeTiling& t1, TCubeTiling& t2)
{
    GlobalTensor<uint32_t> g;
    g.SetGlobalBuffer((__gm__ uint32_t*)tilingGm);
    constexpr uint32_t hw = (sizeof(SageAttention310TilingData) + 3) / 4;
    constexpr uint32_t tw = (sizeof(TCubeTiling) + 3) / 4;
    uint32_t* hp = reinterpret_cast<uint32_t*>(&h);
    for (uint32_t i = 0; i < hw; i++) {
        hp[i] = g.GetValue(i);
    }
    uint32_t* p1 = reinterpret_cast<uint32_t*>(&t1);
    for (uint32_t i = 0; i < tw; i++) {
        p1[i] = g.GetValue(hw + i);
    }
    uint32_t* p2 = reinterpret_cast<uint32_t*>(&t2);
    for (uint32_t i = 0; i < tw; i++) {
        p2[i] = g.GetValue(hw + tw + i);
    }
}

class KernelSageAttention310 {
public:
    SA310_MM1 bmm1;
    SA310_MM2 bmm2;

    __aicore__ inline KernelSageAttention310() {}

    __aicore__ inline void InitTiling(__gm__ uint8_t* tilingGm)
    {
        ReadTilingBlob310(tilingGm, h_, bmm1Tiling_, bmm2Tiling_);
        blockIdx_ = (uint32_t)GetBlockIdx();
        blockNum_ = (uint32_t)GetBlockNum();
        coreBase_ = blockIdx_ * h_.coreScratchStride;
    }

    __aicore__ inline void Init(GM_ADDR q, GM_ADDR k, GM_ADDR v, GM_ADDR o,
                                GM_ADDR workspace, TPipe* pipe)
    {
        pipe_ = pipe;
        const uint32_t rows = h_.nRowsPadded;
        headStride_ = (uint64_t)h_.N * h_.d;

        qGm_.SetGlobalBuffer((__gm__ half*)q, (uint64_t)h_.BH * headStride_);
        kGm_.SetGlobalBuffer((__gm__ half*)k, (uint64_t)h_.BH * headStride_);
        vGm_.SetGlobalBuffer((__gm__ half*)v, (uint64_t)h_.BH * headStride_);
        oGm_.SetGlobalBuffer((__gm__ half*)o, (uint64_t)h_.BH * headStride_);

        __gm__ uint8_t* base = workspace + coreBase_;
        ksGm_.SetGlobalBuffer((__gm__ half*)(base + h_.ksOff), (uint64_t)rows * SA310_D);
        qPadGm_.SetGlobalBuffer((__gm__ half*)(base + h_.qPadOff), (uint64_t)SA310_BQ * SA310_D);
        sGm_.SetGlobalBuffer((__gm__ float*)(base + h_.sOff), (uint64_t)SA310_BQ * SA310_BKV);
        pGm_.SetGlobalBuffer((__gm__ half*)(base + h_.pOff), (uint64_t)SA310_BQ * SA310_BKV);
        cGm_.SetGlobalBuffer((__gm__ float*)(base + h_.cOff), (uint64_t)SA310_BQ * SA310_DV);

        // 310B: no KFC; Matmul runs synchronously on the same core.
        bmm1.Init(&bmm1Tiling_, pipe_);
        bmm2.Init(&bmm2Tiling_, pipe_);

        pipe_->InitBuffer(scratch_, SA310_UB_TOTAL);
    }

    __aicore__ inline void Process()
    {
        const uint32_t total = h_.BH * h_.nQBlocks;
        const uint32_t per = (total + blockNum_ - 1u) / blockNum_;
        const uint32_t begin = blockIdx_ * per;
        const uint32_t end = (begin + per < total) ? (begin + per) : total;
        if (begin >= end) {
            return;
        }

        uint32_t curBh = 0xFFFFFFFFu;
        for (uint32_t it = begin; it < end; it++) {
            const uint32_t bh = it / h_.nQBlocks;
            const uint32_t qb = it % h_.nQBlocks;
            if (bh != curBh) {
                KSmoothPrologue(bh);
                curBh = bh;
            }
            ProcessQBlock(bh, qb * SA310_BQ);
        }
    }

private:
    // Ks[r, :] = K[r, :] - mean(K[r, :]); stored back to GM as fp16.
    __aicore__ inline void KSmoothPrologue(uint32_t bh)
    {
        LocalTensor<half>  kH = scratch_.Get<half>()[SA310_UB_OFF_H / 2];
        LocalTensor<float> kF = scratch_.Get<float>()[SA310_UB_OFF_F32 / 4];
        LocalTensor<float> rsum = scratch_.Get<float>()[SA310_UB_OFF_RSUM / 4];
        const uint32_t cnt = SA310_KCHUNK * SA310_D;
        const uint64_t headBase = (uint64_t)bh * headStride_;

        for (uint32_t c0 = 0; c0 < h_.nRowsPadded; c0 += SA310_KCHUNK) {
            DataCopy(kH, kGm_[headBase + c0 * SA310_D], cnt);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Cast<float, half>(kF, kH, RoundMode::CAST_NONE, cnt);
            // Vectorised row mean: one WholeReduceSum for all 64 rows.
            WholeReduceSum(rsum, kF, (int32_t)SA310_D, (uint8_t)SA310_KCHUNK, 1, 1,
                           (int32_t)(SA310_D / 8));
            PipeBarrier<PIPE_V>();
            LocalTensor<float> meanV = scratch_.Get<float>()[SA310_UB_OFF_M / 4];
            LocalTensor<float> meanB = scratch_.Get<float>()[SA310_UB_OFF_MB / 4];
            Muls(meanV, rsum, h_.invDf, SA310_KCHUNK);
            PipeBarrier<PIPE_V>();
            Brcb(meanB, meanV, (uint8_t)(SA310_KCHUNK / 8), BrcbRepeatParams(1, 8));
            PipeBarrier<PIPE_V>();
            const BinaryRepeatParams rowSub(1, 1, 1,
                (uint8_t)(SA310_D / 8), (uint8_t)(SA310_D / 8), 1);
            for (uint32_t c = 0; c < SA310_D / 8u; c++) {
                Sub(kF[c * 8u], kF[c * 8u], meanB, (uint64_t)0xFF,
                    (uint8_t)SA310_KCHUNK, rowSub);
            }
            PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            Cast<half, float>(kH, kF, RoundMode::CAST_ROUND, cnt);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopy(ksGm_[c0 * SA310_D], kH, cnt);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }

    __aicore__ inline void QPadPrologue(uint32_t bh, uint32_t qStart)
    {
        LocalTensor<half>  qH = scratch_.Get<half>()[SA310_UB_OFF_H / 2];
        LocalTensor<float> qF = scratch_.Get<float>()[SA310_UB_OFF_BIG / 4];
        const uint32_t cnt = SA310_BQ * SA310_D;
        const uint64_t headBase = (uint64_t)bh * headStride_;

        DataCopy(qH, qGm_[headBase + qStart * SA310_D], cnt);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast<float, half>(qF, qH, RoundMode::CAST_NONE, cnt);
        Muls(qF, qF, h_.invSqrtDf, cnt);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        Cast<half, float>(qH, qF, RoundMode::CAST_ROUND, cnt);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopy(qPadGm_, qH, cnt);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }

    __aicore__ inline void ProcessQBlock(uint32_t bh, uint32_t qStart)
    {
        const uint64_t headBase = (uint64_t)bh * headStride_;
        QPadPrologue(bh, qStart);

        LocalTensor<float> sUB   = scratch_.Get<float>()[SA310_UB_OFF_F32 / 4];
        LocalTensor<half>  pUB   = scratch_.Get<half>()[SA310_UB_OFF_H / 2];
        LocalTensor<float> pvUB  = scratch_.Get<float>()[SA310_UB_OFF_BIG / 4];
        LocalTensor<half>  outH  = scratch_.Get<half>()[SA310_UB_OFF_H2 / 2];
        LocalTensor<float> oAcc  = scratch_.Get<float>()[SA310_UB_OFF_OACC / 4];
        LocalTensor<float> mOld  = scratch_.Get<float>()[SA310_UB_OFF_M / 4];
        LocalTensor<float> mNew  = scratch_.Get<float>()[SA310_UB_OFF_MNEW / 4];
        LocalTensor<float> rMax  = scratch_.Get<float>()[SA310_UB_OFF_RMAX / 4];
        LocalTensor<float> rTmp  = scratch_.Get<float>()[SA310_UB_OFF_RTMP / 4];
        LocalTensor<float> alpha = scratch_.Get<float>()[SA310_UB_OFF_A / 4];
        LocalTensor<float> alphaB = scratch_.Get<float>()[SA310_UB_OFF_AB / 4];
        LocalTensor<float> mB    = scratch_.Get<float>()[SA310_UB_OFF_MB / 4];
        LocalTensor<float> lState = scratch_.Get<float>()[SA310_UB_OFF_L / 4];
        LocalTensor<float> lNew   = scratch_.Get<float>()[SA310_UB_OFF_LNEW / 4];

        Duplicate(oAcc, 0.0f, SA310_BQ * SA310_DV);
        Duplicate(mOld, -1e30f, SA310_BQ);
        Duplicate(lState, 0.0f, SA310_BQ);
        PipeBarrier<PIPE_V>();

        for (uint32_t kvb = 0; kvb < h_.nKvBlocks; kvb++) {
            // ---- bmm1: S = Qpad @ Ks^T (fp16 -> fp32), synchronous ----
            bmm1.SetTensorA(qPadGm_, false);
            bmm1.SetTensorB(ksGm_[kvb * SA310_BKV * SA310_D], true);
            bmm1.SetSingleShape(SA310_BQ, SA310_BKV, SA310_D);
            bmm1.IterateAll(sGm_);

            DataCopy(sUB, sGm_, SA310_BQ * SA310_BKV);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

            // ---- online softmax with running max ----
            WholeReduceMax<float>(rMax, sUB, 64, (uint8_t)SA310_BQ, 1, 1,
                                  (int32_t)(SA310_BKV / 8), ReduceOrder::ORDER_ONLY_VALUE);
            for (uint32_t c = 1; c < SA310_BKV / 64u; c++) {
                WholeReduceMax<float>(rTmp, sUB[c * 64u], 64, (uint8_t)SA310_BQ, 1, 1,
                                      (int32_t)(SA310_BKV / 8), ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                Max(rMax, rMax, rTmp, SA310_BQ);
                PipeBarrier<PIPE_V>();
            }
            Max(mNew, mOld, rMax, SA310_BQ);
            Sub(alpha, mOld, mNew, SA310_BQ);
            Exp(alpha, alpha, SA310_BQ);
            PipeBarrier<PIPE_V>();
            Brcb(mB, mNew, (uint8_t)(SA310_BQ / 8), BrcbRepeatParams(1, 8));
            Brcb(alphaB, alpha, (uint8_t)(SA310_BQ / 8), BrcbRepeatParams(1, 8));
            Adds(mOld, mNew, 0.0f, SA310_BQ);
            PipeBarrier<PIPE_V>();

            const BinaryRepeatParams rowSub(1, 1, 1,
                (uint8_t)(SA310_BKV / 8), (uint8_t)(SA310_BKV / 8), 1);
            for (uint32_t c = 0; c < SA310_BKV / 8u; c++) {
                Sub(sUB[c * 8u], sUB[c * 8u], mB, (uint64_t)0xFF, (uint8_t)SA310_BQ, rowSub);
            }
            PipeBarrier<PIPE_V>();
            Exp(sUB, sUB, SA310_BQ * SA310_BKV);

            WholeReduceSum(lNew, sUB, 64, (uint8_t)SA310_BQ, 1, 1, (int32_t)(SA310_BKV / 8));
            for (uint32_t c = 1; c < SA310_BKV / 64u; c++) {
                WholeReduceSum(rTmp, sUB[c * 64u], 64, (uint8_t)SA310_BQ, 1, 1,
                               (int32_t)(SA310_BKV / 8));
                PipeBarrier<PIPE_V>();
                Add(lNew, lNew, rTmp, SA310_BQ);
                PipeBarrier<PIPE_V>();
            }
            Cast<half, float>(pUB, sUB, RoundMode::CAST_ROUND, SA310_BQ * SA310_BKV);

            // Rescale O and l by alpha (they are relative to m_old).
            if (kvb > 0) {
                const BinaryRepeatParams rowMul(1, 1, 1,
                    (uint8_t)(SA310_DV / 8), (uint8_t)(SA310_DV / 8), 1);
                for (uint32_t c = 0; c < SA310_DV / 8u; c++) {
                    Mul(oAcc[c * 8u], oAcc[c * 8u], alphaB, (uint64_t)0xFF, (uint8_t)SA310_BQ, rowMul);
                }
                PipeBarrier<PIPE_V>();
            }
            Mul(lState, lState, alpha, SA310_BQ);
            PipeBarrier<PIPE_V>();
            Add(lState, lState, lNew, SA310_BQ);
            PipeBarrier<PIPE_V>();

            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopy(pGm_, pUB, SA310_BQ * SA310_BKV);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);

            // ---- bmm2: C = P @ V (fp16 -> fp32), synchronous ----
            bmm2.SetTensorA(pGm_, false);
            bmm2.SetTensorB(vGm_[headBase + kvb * SA310_BKV * SA310_D], false);
            bmm2.SetSingleShape(SA310_BQ, SA310_DV, SA310_BKV);
            bmm2.IterateAll(cGm_);

            DataCopy(pvUB, cGm_, SA310_BQ * SA310_DV);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Add(oAcc, oAcc, pvUB, SA310_BQ * SA310_DV);
            PipeBarrier<PIPE_V>();
        }

        // ---- epilogue: O = O / l (vector reciprocal, no scalar reads) ----
        LocalTensor<float> ones = scratch_.Get<float>()[SA310_UB_OFF_M / 4];
        LocalTensor<float> inv  = scratch_.Get<float>()[SA310_UB_OFF_RMAX / 4];
        LocalTensor<float> invB = scratch_.Get<float>()[SA310_UB_OFF_MB / 4];
        Duplicate(ones, 1.0f, SA310_BQ);
        PipeBarrier<PIPE_V>();
        Div(inv, ones, lState, SA310_BQ);          // l >= 1 for a non-empty softmax
        PipeBarrier<PIPE_V>();
        Brcb(invB, inv, (uint8_t)(SA310_BQ / 8), BrcbRepeatParams(1, 8));
        PipeBarrier<PIPE_V>();
        const BinaryRepeatParams rowMul(1, 1, 1,
            (uint8_t)(SA310_DV / 8), (uint8_t)(SA310_DV / 8), 1);
        for (uint32_t c = 0; c < SA310_DV / 8u; c++) {
            Mul(oAcc[c * 8u], oAcc[c * 8u], invB, (uint64_t)0xFF,
                (uint8_t)SA310_BQ, rowMul);
        }
        PipeBarrier<PIPE_V>();
        Cast<half, float>(outH, oAcc, RoundMode::CAST_ROUND, SA310_BQ * SA310_DV);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopy(oGm_[headBase + qStart * SA310_D], outH, SA310_BQ * SA310_D);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }

    SageAttention310TilingData h_;
    TCubeTiling bmm1Tiling_;
    TCubeTiling bmm2Tiling_;
    TPipe* pipe_ = nullptr;
    TBuf<TPosition::VECCALC> scratch_;
    uint32_t blockIdx_ = 0;
    uint32_t blockNum_ = 1;
    uint32_t coreBase_ = 0;
    uint64_t headStride_ = 0;

    GlobalTensor<half> qGm_, kGm_, vGm_, oGm_;
    GlobalTensor<half> ksGm_, qPadGm_, pGm_;
    GlobalTensor<float> sGm_, cGm_;
};

extern "C" __global__ __aicore__ void sageattention310_custom(
    GM_ADDR q, GM_ADDR k, GM_ADDR v, GM_ADDR o, GM_ADDR workspace, GM_ADDR tiling)
{
    if (tiling == nullptr || workspace == nullptr) {
        return;
    }
    KernelSageAttention310 op;
    TPipe pipe;
    op.InitTiling(tiling);
    op.Init(q, k, v, o, workspace, &pipe);
    op.Process();
}

#if !defined(__CCE_AICORE__)
// ===========================================================================
// Host side
// ===========================================================================
#undef DT_FLOAT
#undef DT_FLOAT16
#undef DT_INT8
#undef DT_INT32

static inline uint64_t HostAlignUp310(uint64_t v, uint64_t a) { return (v + a - 1) & ~(a - 1); }

struct SageAttention310Blob {
    SageAttention310TilingData hdr;
    TCubeTiling bmm1;
    TCubeTiling bmm2;
};

static bool BuildTiling310(SageAttention310Blob& blob, uint32_t BH, uint32_t N, uint32_t d, uint32_t coreNum)
{
    if (d != SA310_D || N % SA310_BQ != 0 || N % SA310_BKV != 0) {
        std::cerr << "unsupported shape: d=" << d << " N=" << N << std::endl;
        return false;
    }
    std::memset(&blob, 0, sizeof(blob));

    const uint32_t rows = N;                 // N is a multiple of BKV
    const uint32_t nQBlocks = N / SA310_BQ;
    const uint32_t nKvBlocks = N / SA310_BKV;
    const uint32_t gridDim = std::min(BH * nQBlocks, coreNum);

    blob.hdr.N = N;
    blob.hdr.d = d;
    blob.hdr.nRowsPadded = rows;
    blob.hdr.nQBlocks = nQBlocks;
    blob.hdr.nKvBlocks = nKvBlocks;
    blob.hdr.gridDim = gridDim;
    blob.hdr.invSqrtDf = 1.0f / std::sqrt((float)d);
    blob.hdr.invDf = 1.0f / (float)d;
    blob.hdr.BH = BH;

    uint64_t off = 0;
    uint64_t ksOff = off;    off += (uint64_t)rows * d * sizeof(half);
    off = HostAlignUp310(off, 512);
    uint64_t qPadOff = off;  off += (uint64_t)SA310_BQ * d * sizeof(half);
    off = HostAlignUp310(off, 512);
    uint64_t sOff = off;     off += (uint64_t)SA310_BQ * SA310_BKV * sizeof(float);
    off = HostAlignUp310(off, 512);
    uint64_t pOff = off;     off += (uint64_t)SA310_BQ * SA310_BKV * sizeof(half);
    off = HostAlignUp310(off, 512);
    uint64_t cOff = off;     off += (uint64_t)SA310_BQ * SA310_DV * sizeof(float);
    off = HostAlignUp310(off, 512);

    blob.hdr.ksOff = (uint32_t)ksOff;
    blob.hdr.qPadOff = (uint32_t)qPadOff;
    blob.hdr.sOff = (uint32_t)sOff;
    blob.hdr.pOff = (uint32_t)pOff;
    blob.hdr.cOff = (uint32_t)cOff;
    blob.hdr.coreScratchStride = (uint32_t)HostAlignUp310(off, 512);

    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        return false;
    }

    matmul_tiling::MatmulApiTiling mm1(*platform);
    mm1.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_FLOAT16, false);
    mm1.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_FLOAT16, true);
    mm1.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_FLOAT);
    mm1.SetShape((int32_t)SA310_BQ, (int32_t)SA310_BKV, (int32_t)SA310_D);
    mm1.SetOrgShape((int32_t)SA310_BQ, (int32_t)SA310_BKV, (int32_t)SA310_D);
    mm1.SetBias(false);
    if (mm1.GetTiling(blob.bmm1) != 0) {
        return false;
    }

    matmul_tiling::MatmulApiTiling mm2(*platform);
    mm2.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_FLOAT16, false);
    mm2.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_FLOAT16, false);
    mm2.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_FLOAT);
    mm2.SetShape((int32_t)SA310_BQ, (int32_t)SA310_DV, (int32_t)SA310_BKV);
    mm2.SetOrgShape((int32_t)SA310_BQ, (int32_t)SA310_DV, (int32_t)SA310_BKV);
    mm2.SetBias(false);
    if (mm2.GetTiling(blob.bmm2) != 0) {
        return false;
    }
    return true;
}

// CPU reference: softmax((Q/sqrt(d)) @ (K-rowmean(K))^T) @ V.
static void Reference310(const std::vector<half>& q, const std::vector<half>& k,
                         const std::vector<half>& v, std::vector<float>& out,
                         uint32_t BH, uint32_t N, uint32_t d)
{
    const float scale = 1.0f / std::sqrt((float)d);
    out.assign((size_t)BH * N * d, 0.0f);
    std::vector<float> ks(N * d), qs(N * d), s(N), p(N);

    for (uint32_t b = 0; b < BH; b++) {
        const half* qb = q.data() + (size_t)b * N * d;
        const half* kb = k.data() + (size_t)b * N * d;
        const half* vb = v.data() + (size_t)b * N * d;
        for (uint32_t i = 0; i < N; i++) {
            float mean = 0.0f;
            for (uint32_t t = 0; t < d; t++) mean += (float)kb[i * d + t];
            mean /= (float)d;
            for (uint32_t t = 0; t < d; t++) {
                ks[i * d + t] = (float)kb[i * d + t] - mean;
                qs[i * d + t] = (float)qb[i * d + t] * scale;
            }
        }
        for (uint32_t i = 0; i < N; i++) {
            float m = -1e30f;
            for (uint32_t j = 0; j < N; j++) {
                float acc = 0.0f;
                for (uint32_t t = 0; t < d; t++) acc += qs[i * d + t] * ks[j * d + t];
                s[j] = acc;
                if (acc > m) m = acc;
            }
            float l = 0.0f;
            for (uint32_t j = 0; j < N; j++) {
                p[j] = std::exp(s[j] - m);
                l += p[j];
            }
            for (uint32_t t = 0; t < d; t++) {
                float acc = 0.0f;
                for (uint32_t j = 0; j < N; j++) acc += p[j] * (float)vb[j * d + t];
                out[((size_t)b * N + i) * d + t] = acc / l;
            }
        }
    }
}

int main(int argc, char** argv)
{
    uint32_t BH = 8, N = 512, d = 64;
    if (argc >= 4) {
        BH = (uint32_t)std::atoi(argv[1]);
        N = (uint32_t)std::atoi(argv[2]);
        d = (uint32_t)std::atoi(argv[3]);
    }

    SageAttention310Blob blob;
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint32_t coreNum = 1;
    if (platform != nullptr) {
        coreNum = platform->GetCoreNumAic();
        if (coreNum == 0) coreNum = platform->GetCoreNumAiv();
        if (coreNum == 0) coreNum = 1;
    }
    if (!BuildTiling310(blob, BH, N, d, coreNum)) {
        std::cerr << "BuildTiling failed" << std::endl;
        return 1;
    }
    const uint32_t grid = blob.hdr.gridDim;

    const size_t elems = (size_t)BH * N * d;
    std::vector<half> q(elems), k(elems), v(elems), o(elems);
    for (size_t i = 0; i < elems; i++) {
        q[i] = (half)(0.5f * std::sin(0.001f * (float)i));
        k[i] = (half)(0.5f * std::cos(0.0013f * (float)i));
        v[i] = (half)(0.3f * std::sin(0.0007f * (float)i));
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    void *qD = nullptr, *kD = nullptr, *vD = nullptr, *oD = nullptr, *wsD = nullptr, *tD = nullptr;
    const size_t bytes = elems * sizeof(half);
    const size_t wsBytes = (size_t)blob.hdr.coreScratchStride * grid + SA310_RESERVED_WORKSPACE;
    aclrtMalloc(&qD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&kD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&vD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&oD, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&wsD, wsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&tD, sizeof(blob), ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(qD, bytes, q.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(kD, bytes, k.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(vD, bytes, v.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(tD, sizeof(blob), &blob, sizeof(blob), ACL_MEMCPY_HOST_TO_DEVICE);

    sageattention310_custom<<<grid, nullptr, stream>>>(
        (GM_ADDR)qD, (GM_ADDR)kD, (GM_ADDR)vD, (GM_ADDR)oD, (GM_ADDR)wsD, (GM_ADDR)tD);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(o.data(), bytes, oD, bytes, ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<float> ref;
    Reference310(q, k, v, ref, BH, N, d);

    float maxDiff = 0.0f;
    for (size_t i = 0; i < elems; i++) {
        maxDiff = std::max(maxDiff, std::fabs((float)o[i] - ref[i]));
    }
    std::cout << "BH=" << BH << " N=" << N << " d=" << d << " grid=" << grid
              << " maxDiff=" << maxDiff << std::endl;

    aclrtFree(qD); aclrtFree(kD); aclrtFree(vD); aclrtFree(oD); aclrtFree(wsD); aclrtFree(tD);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return (maxDiff < 2e-2f) ? 0 : 1;
}
#endif
