/*
 * SAGEAttention (AscendC direct-call) -- Cube/Matmul rewrite.
 *
 * Math identity:
 *   score_ij = (1/sqrt(d)) * Q_i . (K_j - mean(K_j)) = (1/sqrt(d)) * Q_i . K_smoothed_j
 * so putting the Q pre-scale and the K row-mean subtraction into prologues turns the
 * whole score computation into a single cube matmul  S = Qpad @ Ks^T.
 *
 * Multi-head: the tensors are [BH, N, dPadded] and the work is distributed
 * head-major so a core only re-runs the (O(N*d)) prologue when its contiguous
 * work range crosses into a new (b,h). Total prologue work is then ~BH instead
 * of ~BH*gridDim -- the single-head code smoothed the full K on EVERY core,
 * which is 256x redundant once BH = 256.
 *
 * Pipeline (all on AIV, issuing KFC requests to the paired AIC):
 *   prologue  : Ks  = K - rowmean(K) -> per-token INT8 (int8, L1/TSCM NZ)
 *               Vp  = V                              (fp16, L1/TSCM NZ)
 *               both are written once per head and stay resident in L1 for all
 *               q-blocks (Matmul B type = TSCM/NZ).
 *   per qblk  : Qpad = Q / sqrt(d) -> per-token INT8 (int8, [64, dPadded])
 *               bmm1 : S  = Qpad_int8 @ Ks_int8^T    (int32, [64, 256])
 *                      S *= s_q[i] * s_k[j]           (GPU-style dequant)
 *               online softmax (running max) -> P   (fp16, [64, 256])
 *               bmm2 : C  = P @ Vp                   (fp32, [64, d])
 *   epilogue  : O = C[:, 0:d] / C[:, d]
 *
 * Async pipeline: each bmm posts with sync=false + waitIterateAll=true, and the
 * S / P / C GM buffers are double-buffered, so bmm1(i+1) overlaps the copy +
 * softmax of block i, and bmm2(i) overlaps softmax(i+1).
 *
 * NOTE: this file is cross-compiled for dav-c220 but has NOT been run on board
 *       (no NPU in the dev env). See docs/PLAN.md Round 5 for the checklist.
 */

#include <cstdint>
#include <cmath>
#include <cfloat>
#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
#include <type_traits>
#include <utility>
#include "acl/acl.h"

// Host-only tiling headers must come BEFORE the device headers: the device
// header chain (kernel_operator.h -> interface/kernel_type.h) defines the
// generic DT_* macros, which collide with the enum identifiers of the same
// name in graph/types.h (pulled in here via tiling/matmul/matmul_tiling.h).
#if !defined(__CCE_AICORE__)
#include "tiling/platform/platform_ascendc.h"
#include "tiling/matmul/matmul_tiling.h"
#endif

#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "kernel_tiling/kernel_tiling.h"
#include "data_utils.h"

// ---------------------------------------------------------------------------
// Compile-time constants (target case: N = 1024, d = 64, BH = 256)
// ---------------------------------------------------------------------------
constexpr uint32_t SA_BQ  = 64;   // q rows per block
constexpr uint32_t SA_BKV = 256;  // kv rows per block / cube N of bmm1
constexpr uint32_t SA_D   = 64;   // head dim (== dPadded, cube K)
constexpr uint32_t SA_DV  = 64;   // V width (no augmented ones column; l is explicit)
constexpr uint32_t SA_KCHUNK = 64;   // K-smoothing chunk (rows)
constexpr uint32_t SA_VCHUNK = 128;  // V-augment chunk (rows)

constexpr uint32_t SA_RESERVED_WORKSPACE = 16u * 1024u * 1024u;  // == AscendC RESERVED_WORKSPACE

// UB scratch layout inside a single VECCALC TBuf (byte offsets). Segment sizes
// are derived from the compile-time shape so tuning SA_D / SA_DV keeps the
// layout consistent (previously these were hand-maintained byte constants).
constexpr uint32_t SA_UB_BIG  = (SA_VCHUNK * SA_DV * 2u > SA_BQ * SA_DV * 4u)
                              ? (SA_VCHUNK * SA_DV * 2u) : (SA_BQ * SA_DV * 4u); // V-aug half / pv float
constexpr uint32_t SA_UB_F32  = SA_BQ * SA_BKV * 4u;   // S tile (fp32 [BQ,BKV]) dominates
constexpr uint32_t SA_UB_H    = SA_BQ * SA_BKV * 2u;   // P tile (half [BQ,BKV]) dominates
constexpr uint32_t SA_UB_H2   = SA_BQ * SA_D * 2u;     // O output tile (half)
constexpr uint32_t SA_UB_OACC = SA_BQ * SA_DV * 4u;    // O accumulator (fp32)
constexpr uint32_t SA_UB_RW   = 1024u;                 // ReduceSum tmp
constexpr uint32_t SA_UB_RSUM = SA_KCHUNK * 4u;        // per-row sums (fp32)
constexpr uint32_t SA_UB_ROW  = SA_D * 4u;             // epilogue row tmp (fp32)
// online-softmax state (all fp32, per row)
constexpr uint32_t SA_UB_M    = SA_BQ * 4u;            // m_old
constexpr uint32_t SA_UB_RMAX = SA_BQ * 4u;            // row max of the current S tile
constexpr uint32_t SA_UB_RTMP = SA_BQ * 4u;            // row-max merge tmp
constexpr uint32_t SA_UB_A    = SA_BQ * 4u;            // alpha = exp(m_old - m_new)
constexpr uint32_t SA_UB_AB   = SA_BQ * 8u * 4u;       // Brcb(alpha): 8 copies per row
constexpr uint32_t SA_UB_MB   = SA_BQ * 8u * 4u;       // Brcb(m_new / q scale): 8 per row
constexpr uint32_t SA_UB_KS   = SA_BKV * 4u;           // per-token K dequant scale
constexpr uint32_t SA_UB_QS   = SA_BQ * 4u;            // per-token Q dequant scale (persists per q-block)
constexpr uint32_t SA_UB_L    = SA_BQ * 4u;            // explicit softmax denominator l

constexpr uint32_t UB_OFF_BIG  = 0;
constexpr uint32_t UB_OFF_F32  = UB_OFF_BIG  + SA_UB_BIG;
constexpr uint32_t UB_OFF_H    = UB_OFF_F32  + SA_UB_F32;
constexpr uint32_t UB_OFF_H2   = UB_OFF_H    + SA_UB_H;
constexpr uint32_t UB_OFF_OACC = UB_OFF_H2   + SA_UB_H2;
constexpr uint32_t UB_OFF_RW   = UB_OFF_OACC + SA_UB_OACC;
constexpr uint32_t UB_OFF_RSUM = UB_OFF_RW   + SA_UB_RW;
constexpr uint32_t UB_OFF_ROW  = UB_OFF_RSUM + SA_UB_RSUM;
constexpr uint32_t UB_OFF_M    = UB_OFF_ROW  + SA_UB_ROW;
constexpr uint32_t UB_OFF_MNEW = UB_OFF_M    + SA_UB_M;
constexpr uint32_t UB_OFF_RMAX = UB_OFF_MNEW + SA_UB_M;
constexpr uint32_t UB_OFF_RTMP = UB_OFF_RMAX + SA_UB_RMAX;
constexpr uint32_t UB_OFF_A    = UB_OFF_RTMP + SA_UB_RTMP;
constexpr uint32_t UB_OFF_AB   = UB_OFF_A    + SA_UB_A;
constexpr uint32_t UB_OFF_MB   = UB_OFF_AB   + SA_UB_AB;
constexpr uint32_t UB_OFF_KS   = UB_OFF_MB   + SA_UB_MB;
constexpr uint32_t UB_OFF_QS   = UB_OFF_KS   + SA_UB_KS;
constexpr uint32_t UB_OFF_L    = UB_OFF_QS   + SA_UB_QS;
constexpr uint32_t UB_TOTAL    = UB_OFF_L    + SA_UB_L;    // ~144 KB for d=64, bkv=256 < 192 KB

// ---------------------------------------------------------------------------
// Tiling blob shared by host and device.
// Every field is 32-bit so the device copy is a plain word-wise scalar read.
// Layout:  SageAttentionTilingData | TCubeTiling (bmm1) | TCubeTiling (bmm2)
// ---------------------------------------------------------------------------
struct SageAttentionTilingData {
    uint32_t N;
    uint32_t d;
    uint32_t dPadded;
    uint32_t BH;              // batch * heads == number of (b,h) pairs
    uint32_t nRowsPadded;     // roundUp(N, SA_BKV)
    uint32_t nQBlocks;        // N / SA_BQ
    uint32_t nKvBlocks;       // N / SA_BKV
    uint32_t gridDim;         // launched block dim
    float    invSqrtDf;
    float    invDf;
    uint32_t qPadOff;
    uint32_t kScaleOff;
    uint32_t sOff;
    uint32_t pOff;
    uint32_t pvOff;
    uint32_t coreScratchStride;
};

// Device section. bisheng compiles a single .asc source into both a host and a
// device pass; the device class and the __global__ entry below must stay visible
// to the host pass (it emits the <<<>>> launch), so they are NOT guarded by
// __CCE_AICORE__ -- only host-tiling-only headers and host code are.

using namespace AscendC;

// ---- matmul type aliases ---------------------------------------------------
// bmm1 (QK) follows the GPU INT8 path: Q_int8 @ Ks_int8^T -> int32, then the
// per-token scales are applied on the vector side.
using SA_A1  = MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using SA_B1  = MatmulType<TPosition::TSCM, CubeFormat::NZ, int8_t, true>;   // Ks is [N, K], int8, L1
using SA_A2  = MatmulType<TPosition::GM, CubeFormat::ND, half, false>;
using SA_B2  = MatmulType<TPosition::TSCM, CubeFormat::NZ, half, false>;    // Vp is [K, N], fp16, L1
using SA_C1  = MatmulType<TPosition::GM, CubeFormat::ND, int32_t, false>;
using SA_C2  = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
using SA_MM1 = Matmul<SA_A1, SA_B1, SA_C1>;
using SA_MM2 = Matmul<SA_A2, SA_B2, SA_C2>;

// ---- device-side tiling read (scalar GetValue -> stack locals) -------------
__aicore__ inline void ReadTilingBlob(__gm__ uint8_t* tilingGm, SageAttentionTilingData& h,
                                      TCubeTiling& t1, TCubeTiling& t2)
{
    GlobalTensor<uint32_t> g;
    g.SetGlobalBuffer((__gm__ uint32_t*)tilingGm);
    constexpr uint32_t hw  = (sizeof(SageAttentionTilingData) + 3) / 4;
    constexpr uint32_t tw  = (sizeof(TCubeTiling) + 3) / 4;
    uint32_t* hp = reinterpret_cast<uint32_t*>(&h);
    for (uint32_t i = 0; i < hw; i++) {
        hp[i] = g.GetValue(i);
    }
    uint32_t* p1 = reinterpret_cast<uint32_t*>(&t1);
    for (uint32_t i = 0; i < tw; i++) {
        p1[i] = g.GetValue(hw + i);
    }
    uint32_t* p2 = reinterpret_cast<uint32_t*>(&t2);
    for (uint32_t i = 0; i < tw; i++) {
        p2[i] = g.GetValue(hw + tw + i);
    }
}

// WaitIterateAll() exists on the AIV matmul client (real wait) and on the AIC
// server (no-op), but the host pass sees a stub Matmul that lacks it. Detect
// the method so this shared kernel class compiles on all three passes.
template <class T, class = void>
struct SAHasWaitIterateAll : std::false_type {};
template <class T>
struct SAHasWaitIterateAll<T, std::void_t<decltype(std::declval<T&>().WaitIterateAll())>>
    : std::true_type {};

template <class T>
__aicore__ inline void SAWaitAsync(T& mm)
{
    if constexpr (SAHasWaitIterateAll<T>::value) {
        mm.WaitIterateAll();
    }
}

class KernelSageAttention {
public:
    SA_MM1 bmm1;    // even KV blocks
    SA_MM1 bmm1b;   // odd KV blocks (2-deep bmm1 pipeline)
    SA_MM2 bmm2;

    __aicore__ inline KernelSageAttention() {}

    __aicore__ inline void InitTiling(__gm__ uint8_t* tilingGm)
    {
        ReadTilingBlob(tilingGm, h_, bmm1Tiling_, bmm2Tiling_);
        blockIdx_ = (uint32_t)GetBlockIdx();
        blockNum_ = (uint32_t)GetBlockNum();
        coreBase_ = blockIdx_ * h_.coreScratchStride;
    }

    __aicore__ inline const TCubeTiling* GetBmm1Tiling() { return &bmm1Tiling_; }
    __aicore__ inline const TCubeTiling* GetBmm2Tiling() { return &bmm2Tiling_; }

    __aicore__ inline void Init(GM_ADDR q, GM_ADDR k, GM_ADDR v, GM_ADDR o, GM_ADDR workspace, TPipe* pipe)
    {
        pipe_ = pipe;
        uint32_t dPadded = h_.dPadded;
        uint32_t rows = h_.nRowsPadded;

        // Tensors are [BH, N, dPadded]; headStride_ is the element step between
        // consecutive (b,h) planes. Each core only touches its own heads.
        headStride_ = h_.N * dPadded;

        qGm_.SetGlobalBuffer((__gm__ half*)q, (uint64_t)h_.BH * headStride_);
        kGm_.SetGlobalBuffer((__gm__ half*)k, (uint64_t)h_.BH * headStride_);
        vGm_.SetGlobalBuffer((__gm__ half*)v, (uint64_t)h_.BH * headStride_);
        oGm_.SetGlobalBuffer((__gm__ half*)o, (uint64_t)h_.BH * headStride_);

        __gm__ uint8_t* base = workspace + coreBase_;
        qPadGm_.SetGlobalBuffer((__gm__ int8_t*)(base + h_.qPadOff), (uint64_t)SA_BQ * SA_D);
        kScaleGm_.SetGlobalBuffer((__gm__ float*)(base + h_.kScaleOff), (uint64_t)h_.N);
        // S is triple-buffered (bmm1 runs up to 2 blocks ahead); P/C stay doubled.
        sGm_.SetGlobalBuffer((__gm__ int32_t*)(base + h_.sOff), (uint64_t)3 * SA_BQ * SA_BKV);
        pGm_.SetGlobalBuffer((__gm__ half*)(base + h_.pOff), (uint64_t)2 * SA_BQ * SA_BKV);
        pvGm_.SetGlobalBuffer((__gm__ float*)(base + h_.pvOff), (uint64_t)2 * SA_BQ * SA_DV);

        // L1 (TSCM) residency: 2B * rows * d for Ks, 2B * rows * SA_DV for Vp.
        pipe_->InitBuffer(ksL1_, (uint32_t)(rows * SA_D * sizeof(int8_t)));
        pipe_->InitBuffer(vpL1_, (uint32_t)(rows * SA_DV * sizeof(half)));

        pipe_->InitBuffer(scratch_, UB_TOTAL);
    }

    __aicore__ inline void Process()
    {
        // Head-major contiguous partition of the BH*nQBlocks work items.
        // A core owns the contiguous range [begin, end);  because the items are
        // ordered (bh-major, qb-minor), that range spans a handful of heads only,
        // so the prologue is re-run once per head a core actually touches.
        // Redundancy ~ (BH + gridDim - 1) / BH ~ 1x, independent of BH.
        const uint32_t nQ = h_.nQBlocks;
        const uint32_t total = h_.BH * nQ;
        const uint32_t per = (total + blockNum_ - 1) / blockNum_;
        const uint32_t begin = blockIdx_ * per;
        uint32_t end = begin + per;
        if (end > total) {
            end = total;
        }

        uint32_t curBh = 0xFFFFFFFFu;
        for (uint32_t it = begin; it < end; it++) {
            const uint32_t bh = it / nQ;
            const uint32_t qb = it - bh * nQ;
            if (bh != curBh) {
                KSmoothPrologue(bh);
                VPadPrologue(bh);
                curBh = bh;
            }
            ProcessQBlock(bh, qb);
        }
    }

private:
    // GPU-style per-token quantization:
    //   scale = rowmax(|x|) / 127,  x_int8 = round(x / scale)
    // xF is scaled in place; sOut gets the per-row dequant scale (fp32).
    __aicore__ inline void QuantizeRowsF32(const LocalTensor<float>& xF, uint32_t rows, uint32_t cols,
                                           const LocalTensor<float>& sOut, const LocalTensor<half>& xH,
                                           const LocalTensor<int8_t>& xI8)
    {
        LocalTensor<float> tmp = scratch_.Get<float>()[UB_OFF_BIG / 4];   // abs tile (>= rows*cols)
        LocalTensor<float> qB  = scratch_.Get<float>()[UB_OFF_MB / 4];    // Brcb [rows, 8]
        const uint32_t cnt = rows * cols;

        Abs(tmp, xF, cnt);                                       // |x| in one pass
        WholeReduceMax(sOut, tmp, (int32_t)cols, (uint8_t)rows, 1, 1,
                       (int32_t)(cols / 8), ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        Maxs(sOut, sOut, 1e-8f, rows);

        LocalTensor<float> recip = tmp;                          // reuse abs tile head
        Duplicate(recip, 127.0f, rows);
        PipeBarrier<PIPE_V>();
        Div(recip, recip, sOut, rows);                           // 127 / max|x|
        PipeBarrier<PIPE_V>();
        Brcb(qB, recip, (uint8_t)(rows / 8), BrcbRepeatParams(1, 8));
        Muls(sOut, sOut, 1.0f / 127.0f, rows);                   // dequant scale
        PipeBarrier<PIPE_V>();

        const BinaryRepeatParams rowMul(1, 1, 1,
            (uint8_t)(cols / 8), (uint8_t)(cols / 8), 1);
        for (uint32_t c = 0; c < cols / 8u; c++) {
            Mul(xF[c * 8u], xF[c * 8u], qB, (uint64_t)0xFF, (uint8_t)rows, rowMul);
        }
        PipeBarrier<PIPE_V>();
        Cast<half, float>(xH, xF, RoundMode::CAST_ROUND, cnt);
        PipeBarrier<PIPE_V>();
        Cast<int8_t, half>(xI8, xH, RoundMode::CAST_RINT, cnt);
    }

    // Ks[r, :] = K[r, :] - mean(K[r, :]);  padded rows are zero-filled.
    // Called once per (b,h) a core touches: only this head's rows are smoothed.
    __aicore__ inline void KSmoothPrologue(uint32_t bh)
    {
        LocalTensor<half>  kH = scratch_.Get<half>()[UB_OFF_H / 2];
        LocalTensor<float> kF = scratch_.Get<float>()[UB_OFF_F32 / 4];
        LocalTensor<float> rsum = scratch_.Get<float>()[UB_OFF_RSUM / 4];
        LocalTensor<float> rwork = scratch_.Get<float>()[UB_OFF_RW / 4];
        const uint32_t cnt = SA_KCHUNK * SA_D;
        const uint32_t headBase = bh * headStride_;
        LocalTensor<int8_t> kI8L1 = ksL1_.Get<int8_t>();

        for (uint32_t c0 = 0; c0 < h_.nRowsPadded; c0 += SA_KCHUNK) {
            DataCopy(kH, kGm_[headBase + c0 * SA_D], cnt);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Cast<float, half>(kF, kH, RoundMode::CAST_NONE, cnt);
            for (uint32_t r = 0; r < SA_KCHUNK; r++) {
                ReduceSum<float, false>(rsum[r], kF[r * SA_D], rwork, (int32_t)SA_D);
            }
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            for (uint32_t r = 0; r < SA_KCHUNK; r++) {
                float mean = rsum.GetValue(r) * h_.invDf;
                Adds(kF[r * SA_D], kF[r * SA_D], -mean, SA_D);
            }
            LocalTensor<float> kS = scratch_.Get<float>()[UB_OFF_QS / 4];
            LocalTensor<half>  h2 = scratch_.Get<half>()[UB_OFF_H2 / 2];
            LocalTensor<int8_t> kI8 = h2.ReinterpretCast<int8_t>();
            QuantizeRowsF32(kF, SA_KCHUNK, SA_D, kS, kH, kI8);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopy(kScaleGm_[c0], kS, SA_KCHUNK);
            // UB -> L1(TSCM) ND2NZ (int8, C0 = 32)
            Nd2NzParams kp(1, (uint16_t)SA_KCHUNK, (uint16_t)SA_D, 0, (uint16_t)SA_D,
                           (uint16_t)(((SA_KCHUNK + 31u) / 32u) * 32u), 1, 0);
            DataCopy(kI8L1[c0 / 16u * ((SA_D + 31u) / 32u) * 512u], kI8, kp);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }

    // Vp[r, 0:d] = V[r, :];  Vp[r, d] = 1;  rest left as 1 (harmless: masked P is 0).
    __aicore__ inline void VPadPrologue(uint32_t bh)
    {
        LocalTensor<half> vOut = scratch_.Get<half>()[UB_OFF_BIG / 2];
        const uint32_t headBase = bh * headStride_;
        LocalTensor<half> vpL1 = vpL1_.Get<half>();

        for (uint32_t c0 = 0; c0 < h_.nRowsPadded; c0 += SA_VCHUNK) {
            DataCopy(vOut, vGm_[headBase + c0 * SA_D], SA_VCHUNK * SA_D);   // contiguous ND
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Nd2NzParams vp(1, (uint16_t)SA_VCHUNK, (uint16_t)SA_DV, 0, (uint16_t)SA_DV,
                           (uint16_t)(((SA_VCHUNK + 15u) / 16u) * 16u), 1, 0);
            DataCopy(vpL1[c0 / 16u * (SA_DV / 16u) * 256u], vOut, vp);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }

    __aicore__ inline void QPadPrologue(uint32_t bh, uint32_t qStart)
    {
        LocalTensor<half>  qH = scratch_.Get<half>()[UB_OFF_H / 2];
        LocalTensor<float> qF = scratch_.Get<float>()[UB_OFF_F32 / 4];
        const uint32_t cnt = SA_BQ * SA_D;

        DataCopy(qH, qGm_[bh * headStride_ + qStart * SA_D], cnt);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast<float, half>(qF, qH, RoundMode::CAST_NONE, cnt);
        Muls(qF, qF, h_.invSqrtDf, cnt);
        LocalTensor<float> qS = scratch_.Get<float>()[UB_OFF_QS / 4];
        LocalTensor<half>  h2 = scratch_.Get<half>()[UB_OFF_H2 / 2];
        LocalTensor<int8_t> qI8 = h2.ReinterpretCast<int8_t>();
        QuantizeRowsF32(qF, SA_BQ, SA_D, qS, qH, qI8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopy(qPadGm_, qI8, cnt);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }

    // ---- async posts (sync=false + waitIterateAll=true) -------------------
    __aicore__ inline void PostBmm1(uint32_t kvb, uint32_t buf)
    {
        SA_MM1& mm = ((kvb & 1u) != 0u) ? bmm1b : bmm1;
        mm.SetTensorA(qPadGm_, false);
        mm.SetTensorB(ksL1_.Get<int8_t>()[kvb * (SA_BKV / 16u) * ((SA_D + 31u) / 32u) * 512u], true);
        mm.SetSingleShape(SA_BQ, SA_BKV, SA_D);
        mm.IterateAll<false>(sGm_[buf * (SA_BQ * SA_BKV)], 0, false, true);
    }

    __aicore__ inline void PostBmm2(uint32_t kvb, uint32_t buf)
    {
        bmm2.SetTensorA(pGm_[buf * (SA_BQ * SA_BKV)], false);
        bmm2.SetTensorB(vpL1_.Get<half>()[kvb * (SA_BKV / 16u) * (SA_DV / 16u) * 256u], false);
        bmm2.SetSingleShape(SA_BQ, SA_DV, SA_BKV);
        bmm2.IterateAll<false>(pvGm_[buf * (SA_BQ * SA_DV)], 0, false, true);
    }

    __aicore__ inline void ProcessQBlock(uint32_t bh, uint32_t qb)
    {
        uint32_t qStart = qb * SA_BQ;
        const uint32_t headBase = bh * headStride_;
        QPadPrologue(bh, qStart);

        LocalTensor<float> oAcc = scratch_.Get<float>()[UB_OFF_OACC / 4];
        LocalTensor<float> sUB  = scratch_.Get<float>()[UB_OFF_F32 / 4];
        LocalTensor<half>  pUB  = scratch_.Get<half>()[UB_OFF_H / 2];
        LocalTensor<float> pvUB = scratch_.Get<float>()[UB_OFF_BIG / 4];
        LocalTensor<float> mOld   = scratch_.Get<float>()[UB_OFF_M / 4];
        LocalTensor<float> mNew   = scratch_.Get<float>()[UB_OFF_MNEW / 4];
        LocalTensor<float> rMax   = scratch_.Get<float>()[UB_OFF_RMAX / 4];
        LocalTensor<float> rTmp   = scratch_.Get<float>()[UB_OFF_RTMP / 4];
        LocalTensor<float> alpha  = scratch_.Get<float>()[UB_OFF_A / 4];
        LocalTensor<float> alphaB = scratch_.Get<float>()[UB_OFF_AB / 4];
        LocalTensor<float> mB     = scratch_.Get<float>()[UB_OFF_MB / 4];
        LocalTensor<float> lState = scratch_.Get<float>()[UB_OFF_L / 4];
        LocalTensor<float> lNew   = scratch_.Get<float>()[UB_OFF_ROW / 4];  // reused by epilogue later

        Duplicate(oAcc, 0.0f, SA_BQ * SA_DV);
        Duplicate(mOld, -1e30f, SA_BQ);   // running max starts at -inf-ish
        Duplicate(lState, 0.0f, SA_BQ);   // explicit softmax denominator

        // Software pipeline (depth 2):
        //   bmm1(i+1) runs on Cube while AIV copies S(i) + does softmax(i);
        //   bmm2(i) runs on Cube while AIV does softmax(i+1);
        //   C(i) is accumulated one iteration later, before bmm2(i+1) is posted.
        // Depth-3 S pipeline: bmm1(0), bmm1(1) are queued up front; at block i
        // we consume sGm[i%3] and post bmm1(i+2) into sGm[(i+2)%3].
        PostBmm1(0, 0);
        if (h_.nKvBlocks > 1) {
            PostBmm1(1, 1);
        }
        bool     pending = false;
        uint32_t pendBuf = 0;

        for (uint32_t kvb = 0; kvb < h_.nKvBlocks; kvb++) {
            const uint32_t cur = kvb & 1u;

            // Wait only for this block's client (even/odd clients alternate).
            if (cur == 0u) {
                SAWaitAsync(bmm1);
            } else {
                SAWaitAsync(bmm1b);
            }
            if (kvb + 2 < h_.nKvBlocks) {
                PostBmm1(kvb + 2, (kvb + 2) % 3u);
            }

            // ---- INT8 dequant: S = int32 * s_q[i] * s_k[j] ----
            const uint32_t sbuf = kvb % 3u;
            LocalTensor<int32_t> sI32 = sUB.ReinterpretCast<int32_t>();
            DataCopy(sI32, sGm_[sbuf * (SA_BQ * SA_BKV)], SA_BQ * SA_BKV);
            LocalTensor<float> kScaleUb = scratch_.Get<float>()[UB_OFF_KS / 4];
            DataCopy(kScaleUb, kScaleGm_[kvb * SA_BKV], SA_BKV);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Cast<float, int32_t>(sUB, sI32, RoundMode::CAST_RINT, SA_BQ * SA_BKV);
            PipeBarrier<PIPE_V>();

            // per-column K scale: src1 keeps the same 64-wide chunk for every row
            const BinaryRepeatParams colP(1, 1, 1,
                (uint8_t)(SA_BKV / 8), (uint8_t)(SA_BKV / 8), 0);
            for (uint32_t c = 0; c < SA_BKV / 64u; c++) {
                Mul(sUB[c * 64u], sUB[c * 64u], kScaleUb[c * 64u],
                    (uint64_t)0xFFFFFFFFFFFFFFFFULL, (uint8_t)SA_BQ, colP);
            }
            PipeBarrier<PIPE_V>();
            // per-row Q scale
            LocalTensor<float> qS = scratch_.Get<float>()[UB_OFF_QS / 4];
            LocalTensor<float> qB = scratch_.Get<float>()[UB_OFF_MB / 4];
            Brcb(qB, qS, (uint8_t)(SA_BQ / 8), BrcbRepeatParams(1, 8));
            PipeBarrier<PIPE_V>();
            const BinaryRepeatParams rowP(1, 1, 1,
                (uint8_t)(SA_BKV / 8), (uint8_t)(SA_BKV / 8), 1);
            for (uint32_t c = 0; c < SA_BKV / 8u; c++) {
                Mul(sUB[c * 8u], sUB[c * 8u], qB, (uint64_t)0xFF, (uint8_t)SA_BQ, rowP);
            }
            PipeBarrier<PIPE_V>();

            // ---- online softmax (GPU-style running max) ----
            // row max: 4 vector reductions of 64 elements + 3 vector Max merges
            WholeReduceMax<float>(rMax, sUB, 64, (uint8_t)SA_BQ, 1, 1,
                                  (int32_t)(SA_BKV / 8), ReduceOrder::ORDER_ONLY_VALUE);
            for (uint32_t c = 1; c < SA_BKV / 64u; c++) {
                WholeReduceMax<float>(rTmp, sUB[c * 64u], 64, (uint8_t)SA_BQ, 1, 1,
                                      (int32_t)(SA_BKV / 8), ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                Max(rMax, rMax, rTmp, SA_BQ);
                PipeBarrier<PIPE_V>();
            }
            Max(mNew, mOld, rMax, SA_BQ);       // m_new = max(m_old, rowmax(S))
            Sub(alpha, mOld, mNew, SA_BQ);      // <= 0
            Exp(alpha, alpha, SA_BQ);           // alpha = exp(m_old - m_new)
            PipeBarrier<PIPE_V>();
            Brcb(mB, mNew, (uint8_t)(SA_BQ / 8), BrcbRepeatParams(1, 8));
            Brcb(alphaB, alpha, (uint8_t)(SA_BQ / 8), BrcbRepeatParams(1, 8));
            Adds(mOld, mNew, 0.0f, SA_BQ);      // commit the running max
            PipeBarrier<PIPE_V>();

            // S -= m_new, 8 columns per instruction (row broadcast via Brcb)
            const BinaryRepeatParams rowSub(1, 1, 1,
                (uint8_t)(SA_BKV / 8), (uint8_t)(SA_BKV / 8), 1);
            for (uint32_t c = 0; c < SA_BKV / 8u; c++) {
                Sub(sUB[c * 8u], sUB[c * 8u], mB, (uint64_t)0xFF, (uint8_t)SA_BQ, rowSub);
            }
            PipeBarrier<PIPE_V>();
            Exp(sUB, sUB, SA_BQ * SA_BKV);      // exp(S - m_new) in (0, 1]
            // explicit row sum l_new = sum_j exp(S_ij - m_i)
            WholeReduceSum(lNew, sUB, 64, (uint8_t)SA_BQ, 1, 1,
                           (int32_t)(SA_BKV / 8));
            for (uint32_t c = 1; c < SA_BKV / 64u; c++) {
                WholeReduceSum(rTmp, sUB[c * 64u], 64, (uint8_t)SA_BQ, 1, 1,
                               (int32_t)(SA_BKV / 8));
                PipeBarrier<PIPE_V>();
                Add(lNew, lNew, rTmp, SA_BQ);
                PipeBarrier<PIPE_V>();
            }
            Cast<half, float>(pUB, sUB, RoundMode::CAST_ROUND, SA_BQ * SA_BKV);

            // Drain C(kvb-1) BEFORE the rescale: it was computed relative to
            // m_old, so alpha must be applied to it together with the rest of O/l.
            if (pending) {
                SAWaitAsync(bmm2);
                DataCopy(pvUB, pvGm_[pendBuf * (SA_BQ * SA_DV)], SA_BQ * SA_DV);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                Add(oAcc, oAcc, pvUB, SA_BQ * SA_DV);
                PipeBarrier<PIPE_V>();
            }
            // Rescale the accumulated O (blocks 0..kvb-1) to the new max.
            if (kvb > 0) {
                const BinaryRepeatParams rowMul(1, 1, 1,
                    (uint8_t)(SA_DV / 8), (uint8_t)(SA_DV / 8), 1);
                for (uint32_t c = 0; c < SA_DV / 8u; c++) {
                    Mul(oAcc[c * 8u], oAcc[c * 8u], alphaB, (uint64_t)0xFF, (uint8_t)SA_BQ, rowMul);
                }
                PipeBarrier<PIPE_V>();
            }
            // l = alpha * l_old + l_new (same running-max reference as O)
            Mul(lState, lState, alpha, SA_BQ);
            PipeBarrier<PIPE_V>();
            Add(lState, lState, lNew, SA_BQ);
            PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            // P double buffering: pGm_[cur] differs from the buffer bmm2(kvb-1) reads.
            DataCopy(pGm_[cur * (SA_BQ * SA_BKV)], pUB, SA_BQ * SA_BKV);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);

            PostBmm2(kvb, cur);
            pending = true;
            pendBuf = cur;
        }

        // Drain the last C block before the epilogue.
        SAWaitAsync(bmm2);
        DataCopy(pvUB, pvGm_[pendBuf * (SA_BQ * SA_DV)], SA_BQ * SA_DV);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Add(oAcc, oAcc, pvUB, SA_BQ * SA_DV);

        // ---- epilogue: O = C[:, 0:d] / C[:, d] ----
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        LocalTensor<float> rowF = scratch_.Get<float>()[UB_OFF_ROW / 4];
        LocalTensor<half>  outH = scratch_.Get<half>()[UB_OFF_H2 / 2];
        for (uint32_t r = 0; r < SA_BQ; r++) {
            float l = lState.GetValue(r);
            float inv = (l > 1e-30f) ? (1.0f / l) : 0.0f;
            Muls(rowF, oAcc[r * SA_DV], inv, SA_D);
            Cast<half, float>(outH[r * SA_D], rowF, RoundMode::CAST_ROUND, SA_D);
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopy(oGm_[headBase + qStart * SA_D], outH, SA_BQ * SA_D);
    }

    TPipe* pipe_ = nullptr;
    SageAttentionTilingData h_;
    TCubeTiling bmm1Tiling_;
    TCubeTiling bmm2Tiling_;
    uint32_t blockIdx_ = 0;
    uint32_t blockNum_ = 1;
    uint32_t coreBase_ = 0;
    uint32_t headStride_ = 0;   // N * dPadded: element step between (b,h) planes

    GlobalTensor<half>  qGm_, kGm_, vGm_, oGm_;
    GlobalTensor<half>  pGm_;
    GlobalTensor<int8_t> qPadGm_;
    GlobalTensor<float>  kScaleGm_;
    TBuf<TPosition::TSCM> ksL1_;   // Ks (int8) resident in L1 (NZ)
    TBuf<TPosition::TSCM> vpL1_;   // Vp (fp16) resident in L1 (NZ)
    GlobalTensor<int32_t> sGm_;
    GlobalTensor<float> pvGm_;

    TBuf<TPosition::VECCALC> scratch_;
};

KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);

extern "C" __global__ __aicore__ void sageattention_custom(
    GM_ADDR q, GM_ADDR k, GM_ADDR v, GM_ADDR o, GM_ADDR workspace, GM_ADDR tiling)
{
    TPipe pipe;
    KernelSageAttention op;
    op.InitTiling(tiling);
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(),
        op.bmm1, op.GetBmm1Tiling(), op.bmm2, op.GetBmm2Tiling(),
        op.bmm1b, op.GetBmm1Tiling());
    op.Init(q, k, v, o, workspace, &pipe);
    op.Process();
}

// ---------------------------------------------------------------------------
// Host side
// ---------------------------------------------------------------------------
#if !defined(__CCE_AICORE__)

// kernel_type.h (pulled in by kernel_operator.h) defines generic DT_* macros
// that would otherwise expand inside the matmul_tiling::DataType::DT_* enum
// references below. The device pass keeps them; the host pass does not need them.
#undef DT_FLOAT
#undef DT_FLOAT16
#undef DT_INT8
#undef DT_INT32

struct ArgInfo {
    std::string fileName;
    size_t length;
};

static inline uint64_t HostAlignUp(uint64_t v, uint64_t a)
{
    return (v + a - 1) / a * a;
}

struct SageTilingBlob {
    SageAttentionTilingData hdr;
    TCubeTiling bmm1;
    TCubeTiling bmm2;
};

static bool BuildTiling(SageTilingBlob& blob, uint32_t N, uint32_t d, uint32_t dPadded,
                        uint32_t BH, uint32_t aicNum)
{
    if (d != SA_D || dPadded != SA_D) {
        printf("unsupported d/dPadded (expect both == %u)\n", SA_D);
        return false;
    }
    if (N % SA_BQ != 0 || N % SA_BKV != 0) {
        printf("unsupported N (expect multiple of %u and %u)\n", SA_BQ, SA_BKV);
        return false;
    }
    if (BH == 0) {
        printf("unsupported BH (expect >= 1)\n");
        return false;
    }

    uint32_t nRowsPadded = (uint32_t)HostAlignUp(N, SA_BKV);
    uint32_t nQBlocks = N / SA_BQ;
    uint32_t nKvBlocks = N / SA_BKV;
    // Work items are BH*nQBlocks (head-major); grid is capped by the AIC count.
    uint32_t gridDim = std::min(BH * nQBlocks, aicNum);
    if (gridDim == 0) {
        gridDim = 1;
    }

    // ---- per-core scratch layout ----
    uint64_t off = 0;
    uint64_t qPadOff = off; off += (uint64_t)SA_BQ * SA_D * sizeof(int8_t);
    off = HostAlignUp(off, 512);
    uint64_t kScaleOff = off; off += (uint64_t)N * sizeof(float);
    off = HostAlignUp(off, 512);
    uint64_t sOff = off;    off += (uint64_t)3 * SA_BQ * SA_BKV * sizeof(int32_t);
    off = HostAlignUp(off, 512);
    uint64_t pOff = off;    off += (uint64_t)2 * SA_BQ * SA_BKV * sizeof(half);
    off = HostAlignUp(off, 512);
    uint64_t pvOff = off;   off += (uint64_t)2 * SA_BQ * SA_DV * sizeof(float);
    uint64_t stride = HostAlignUp(off, 512);

    blob.hdr.N = N;
    blob.hdr.d = d;
    blob.hdr.dPadded = dPadded;
    blob.hdr.BH = BH;
    blob.hdr.nRowsPadded = nRowsPadded;
    blob.hdr.nQBlocks = nQBlocks;
    blob.hdr.nKvBlocks = nKvBlocks;
    blob.hdr.gridDim = gridDim;
    blob.hdr.invSqrtDf = 1.0f / sqrtf((float)d);
    blob.hdr.invDf = 1.0f / (float)d;
    blob.hdr.qPadOff = (uint32_t)qPadOff;
    blob.hdr.kScaleOff = (uint32_t)kScaleOff;
    blob.hdr.sOff = (uint32_t)sOff;
    blob.hdr.pOff = (uint32_t)pOff;
    blob.hdr.pvOff = (uint32_t)pvOff;
    blob.hdr.coreScratchStride = (uint32_t)stride;

    // ---- cube tilings ----
    auto* plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (plat == nullptr) {
        printf("PlatformAscendCManager::GetInstance() failed\n");
        return false;
    }

    matmul_tiling::MatmulApiTiling mm1(*plat);
    mm1.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT8, false);
    mm1.SetBType(matmul_tiling::TPosition::TSCM, matmul_tiling::CubeFormat::NZ,
                 matmul_tiling::DataType::DT_INT8, true);
    mm1.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT32);
    mm1.SetBias(false);
    mm1.SetShape((int32_t)SA_BQ, (int32_t)SA_BKV, (int32_t)SA_D);
    mm1.SetOrgShape((int32_t)SA_BQ, (int32_t)SA_BKV, (int32_t)SA_D);
    if (mm1.GetTiling(blob.bmm1) != 0) {
        printf("bmm1 GetTiling failed\n");
        return false;
    }

    matmul_tiling::MatmulApiTiling mm2(*plat);
    mm2.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_FLOAT16, false);
    mm2.SetBType(matmul_tiling::TPosition::TSCM, matmul_tiling::CubeFormat::NZ,
                 matmul_tiling::DataType::DT_FLOAT16, false);
    mm2.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_FLOAT);
    mm2.SetBias(false);
    mm2.SetShape((int32_t)SA_BQ, (int32_t)SA_DV, (int32_t)SA_BKV);
    mm2.SetOrgShape((int32_t)SA_BQ, (int32_t)SA_DV, (int32_t)SA_BKV);
    if (mm2.GetTiling(blob.bmm2) != 0) {
        printf("bmm2 GetTiling failed\n");
        return false;
    }
    return true;
}

void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData, size_t tilingBytes, size_t workspaceBytes)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;
    uint8_t *workspaceDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, tilingBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, tilingBytes, tilingData, tilingBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtMalloc((void **)&workspaceDevice, workspaceBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    sageattention_custom<<<blockNum, nullptr, stream>>>(
        inputDevice[0], inputDevice[1], inputDevice[2],
        outputDevice[0], workspaceDevice, tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    aclrtFree(workspaceDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    auto* plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (plat == nullptr) {
        printf("PlatformAscendCManager::GetInstance() failed\n");
        aclrtResetDevice(deviceId);
        return -1;
    }
    uint32_t aicNum = plat->GetCoreNumAic();
    size_t libWsSize = (size_t)plat->GetLibApiWorkSpaceSize();

    uint32_t N = 1024;
    uint32_t d = 64;
    uint32_t dPadded = ((d + 15) / 16) * 16;
    uint32_t BH = 256;   // batch(8) * heads(32) == number of (b,h) pairs

    SageTilingBlob blob;
    if (!BuildTiling(blob, N, d, dPadded, BH, aicNum)) {
        aclrtResetDevice(deviceId);
        return -1;
    }

    size_t sysBytes = std::max(libWsSize, (size_t)SA_RESERVED_WORKSPACE);
    size_t userBytes = (size_t)blob.hdr.coreScratchStride * blob.hdr.gridDim;
    size_t workspaceBytes = sysBytes + userBytes;

    size_t inputByteSize = (size_t)BH * N * dPadded * sizeof(half);
    size_t outputByteSize = (size_t)BH * N * dPadded * sizeof(half);

    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_q.bin", inputByteSize},
        {"./input/input_k.bin", inputByteSize},
        {"./input/input_v.bin", inputByteSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", outputByteSize}
    };

    printf("sageattention: BH=%u N=%u d=%u gridDim=%u scratchStride=%u workspace=%.2f MB\n",
        BH, N, d, blob.hdr.gridDim, blob.hdr.coreScratchStride, workspaceBytes / 1024.0 / 1024.0);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(blob.hdr.gridDim, stream, inputsInfo, outputsInfo,
        (uint8_t *)&blob, sizeof(blob), workspaceBytes);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}

#endif // !__CCE_AICORE__